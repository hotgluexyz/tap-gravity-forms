# Gravity Forms Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-gravity-forms --about` for the
# authoritative list.

# Required: WordPress site URL hosting Gravity Forms
TAP_GRAVITY_FORMS_BASE_URL=https://example.com

# Required: Gravity Forms REST API consumer key
TAP_GRAVITY_FORMS_CONSUMER_KEY=ck_your_consumer_key_here

# Required: Gravity Forms REST API consumer secret
TAP_GRAVITY_FORMS_CONSUMER_SECRET=cs_your_consumer_secret_here

# Required: JSON array of form IDs to sync (env parsing may vary; prefer config.json)
TAP_GRAVITY_FORMS_FORM_IDS=["15"]

# Optional: The earliest record date to sync (ISO-8601)
TAP_GRAVITY_FORMS_START_DATE=2000-01-01T00:00:00Z

# Optional: Entries per page (default 100)
TAP_GRAVITY_FORMS_PAGE_SIZE=100
